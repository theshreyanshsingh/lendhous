# Lendhous environment. Variable names follow UPB Capital's .env.example so both apps are configured the same way.

# MongoDB, Lendhous's own database. Locally this matches docker-compose.yml or `npm run db:dev` (a one-node replica set).
# Production: use a separate Atlas project or cluster for Lendhous (it holds SSNs and credit data), with a user whose only
# role is readWrite on the lendhous database. Release builds refuse synergifund, upb_capital, admin, local and config.
DATABASE_URL="mongodb://127.0.0.1:27017/lendhous?directConnection=true"

# Required in production. `openssl rand -base64 32`. Signs the session cookie. The production build rejects this demo value.
AUTH_SECRET="dev-only-lendhous-secret-change-me-2026"

# Field-level encryption (SSN, DOB, EIN, bank numbers, credit reports).
# Format: id:base64key, newest first; older keys stay listed so existing values still decrypt.
# Blank uses a development key locally. Required in production: k1:$(openssl rand -base64 32)
FIELD_ENCRYPTION_KEYS=""

# Production only. The release build creates this owner-admin once. It does not reset the password later.
# Not a @lendhous.test address, not the demo password.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
LENDER_NAME=""

# Public origin. Production must be https.
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"
# Only for an internal server reached over plain http (pm2 on a port, no proxy). Release builds refuse it.
# ALLOW_HTTP_SESSIONS="1"

# Optional shared team inbox. Team alerts go to every approved owner-admin, and also here when set.
TEAM_EMAIL=""

# Mail. Resend wins when both are set. Otherwise SMTP. Otherwise the server log.
# Required in production: staff sign in with a code sent this way, so release builds refuse to run without it.
RESEND_API_KEY=""
EMAIL_FROM=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# File storage. Local disk is fine for this machine. Production must set one of the two.
# Cloudflare R2 (S3 API): S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com", S3_REGION="auto".
# Prefer Lendhous's own bucket; in a shared bucket set S3_PREFIX="lendhous".
# Vercel Blob: create a private store; Vercel adds BLOB_READ_WRITE_TOKEN. S3 wins if both are set.
# Only S3/R2 can issue the five-minute signed download links.
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PREFIX=""
BLOB_READ_WRITE_TOKEN=""

# Shared rate limits: database (default) or memory.
RATE_LIMIT_STORE="database"

# Required in production. `openssl rand -base64 32`. vercel.json calls GET /api/cron daily with Authorization: Bearer.
CRON_SECRET=""
