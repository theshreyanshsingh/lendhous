// Lendhous data model on MongoDB, following UPB Capital's setup (Prisma, no migrations, `npm run db:indexes`).
// Conventions from Spec v3 Section 3: string UUID ids, money in integer cents (*Cents), rates in basis points (*Bps),
// createdAt / updatedAt everywhere, soft delete with deletedAt. Int is 32-bit on MongoDB: fine for loan-level
// amounts (max $21.4M), so capital totals that can exceed that will use BigInt when they arrive (B3).
// B0 covers identity, access, controls and plumbing. Loan tables arrive with B1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Spec v3 Section 1. A user can hold several roles (user_role is many-to-many).
enum RoleCode {
  BORROWER
  GUARANTOR
  ADMIN_OWNER
  UNDERWRITER
  PROCESSOR
  CAPITAL_MANAGER
  SERVICER
  DRAW_ADMIN
  INSPECTOR
  PARTNER_LENDER
  LOAN_BUYER
  BROKER
  CLOSING_AGENT
  AUDITOR
}

enum AccountStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum OrgType {
  LENDER_HOUSE
  PARTNER_LENDER
  BROKER
  TITLE
}

enum OrgStatus {
  ACTIVE
  INACTIVE
}

enum DocStatus {
  REQUESTED
  UPLOADED
  IN_REVIEW
  ACCEPTED
  REJECTED
  WAIVED
  EXPIRED
}

// Spec v3 3.2 approval.subject_type, plus the always-dual actions from 10.4.
enum ApprovalSubject {
  FUNDING
  DRAW
  DISTRIBUTION
  MATRIX_EXCEPTION
  TERM_SHEET_OVER_LIMIT
  EXTENSION
  FEE_WAIVER
  COI_OVERRIDE
  CHARGE_OFF
  GUARANTOR_RELEASE
  WIRE_CHANGE
}

enum ApprovalDecision {
  APPROVED
  DECLINED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DECLINED
}

model Organization {
  id             String    @id @default(uuid()) @map("_id")
  name           String
  type           OrgType
  licenseNumbers String[]
  status         OrgStatus @default(ACTIVE)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  users          User[]
}

model User {
  id               String        @id @default(uuid()) @map("_id")
  email            String        @unique
  passwordHash     String
  name             String
  phone            String        @default("")
  title            String?
  // Per-person changes to what the roles allow, set on the members page (lib/permissions.ts `can`).
  extraPermissions  String[]
  deniedPermissions String[]
  accountStatus    AccountStatus @default(PENDING)
  // Staff, partner, broker and title users belong to an organization; borrowers and guarantors do not.
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notifyEmail      Boolean       @default(true)
  notifyInApp      Boolean       @default(true)
  lastLoginAt      DateTime?
  // Created through the public sign-up page. Such an account stays PENDING until its email link is used.
  signedUpAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  roles            UserRole[]
  sessions         ServerSession[]
  passwordLinks    PasswordLink[]
  notifications    Notification[]
}

model UserRole {
  id          String   @id @default(uuid()) @map("_id")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        RoleCode
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([userId, role])
}

// Overrides on the default permission matrix in lib/permissions.ts (Spec v3 Section 1 "configurable role matrix").
// Changes are logged in AuditEvent with before and after values.
model RolePermission {
  id          String   @id @default(uuid()) @map("_id")
  role        RoleCode
  permission  String
  enabled     Boolean
  limitCents  Int?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([role, permission])
}

model ServerSession {
  id         String   @id @map("_id")
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  // Staff sessions end after the idle window in PlatformSettings (Spec v3 10.1, placeholder 30 minutes).
  lastSeenAt DateTime @default(now())
  ipAddress  String   @default("")
  userAgent  String   @default("")
  createdAt  DateTime @default(now())

  @@index([expiresAt])
}

// The loan book: one row per record (a loan, a bid, a draw, a message and so on), its shape set by lib/book.ts.
// The version row makes each change all-or-nothing against the latest book (lib/book-store.ts).
model BookRecord {
  id        String   @id @map("_id")
  kind      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

model BookVersion {
  id      String @id @map("_id")
  version Int    @default(0)
}

// The one-time link a new member uses to set a password (lib/members.ts). Only the hash is stored.
model PasswordLink {
  id        String   @id @default(uuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// The link a contractor or borrower opens to send photos of finished work, with no account (lib/photo-links.ts).
// Only the hash is stored. The request it opens lives in the loan book.
model PhotoLink {
  id        String   @id @default(uuid()) @map("_id")
  requestId String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model RateWindow {
  key       String   @id @map("_id")
  count     Int      @default(0)
  expiresAt DateTime
}

// Spec v3 10.3: every change with before and after values, the actor's address and the request id.
model AuditEvent {
  id         String   @id @default(uuid()) @map("_id")
  actorId    String?
  actorIp    String   @default("")
  userAgent  String   @default("")
  requestId  String   @default("")
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// A browser's push subscription (lib/push.ts): where a person's notifications go to their phone or computer. The keys let
// that browser decrypt what's sent; the push service (Google, Apple, Mozilla, Microsoft) only relays it.
model PushSubscription {
  id         String    @id @default(uuid()) @map("_id")
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String    @default("")
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  @@index([userId])
}

model Notification {
  id        String    @id @default(uuid()) @map("_id")
  toEmail   String
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventCode String    @default("")
  subject   String
  body      String
  // Legal and security notices (Spec v3 12.1 "(L)") ignore the user's channel preferences.
  legal     Boolean   @default(false)
  delivery  String    @default("log")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([toEmail])
}

// Spec v3 3.2 document. Owner is polymorphic until the loan tables arrive in B1.
model Document {
  id              String    @id @default(uuid()) @map("_id")
  ownerType       String
  ownerId         String
  documentType    String
  originalName    String
  storageKey      String
  // The key the stored file was encrypted with, so the encryption job reads only files that need it (lib/encrypt-data.ts).
  fileKeyId       String?
  mime            String
  size            Int
  sha256          String
  version         Int       @default(1)
  status          DocStatus @default(UPLOADED)
  reviewerId      String?
  rejectionReason String    @default("")
  expiresAt       DateTime?
  uploadedById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([ownerType, ownerId])
}

// Dual control (Spec v3 3.2 approval, 10.4). One document per request so a MongoDB validator can compare the
// three people on it: initiator, first approver and second approver must all differ (lib/mongo-validators.ts).
model Approval {
  id              String            @id @default(uuid()) @map("_id")
  subjectType     ApprovalSubject
  subjectId       String
  amountCents     Int?
  initiatorId     String
  step1ApproverId String?
  step1Decision   ApprovalDecision?
  step1Reason     String            @default("")
  step1At         DateTime?
  step2ApproverId String?
  step2Decision   ApprovalDecision?
  step2Reason     String            @default("")
  step2At         DateTime?
  status          ApprovalStatus    @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([subjectType, subjectId])
  @@index([status])
}

model PlatformSettings {
  id                            String   @id @map("_id")
  retentionYears                Int      @default(7)
  staffIdleMinutes              Int      @default(30)
  // Offers real accounts the fake sample book. Unset counts as on; turn it off before real clients sign in.
  offerSampleData               Boolean?
  // Spec v3 Section 1 placeholders: second approver above these amounts.
  dualApprovalDrawCents         Int      @default(5000000)
  dualApprovalDistributionCents Int      @default(25000000)
  // Lets people create their own borrower accounts on /login/signup. Unset counts as on.
  allowSignup                   Boolean?
  // The lender's mailing address and phone, printed on notices that need them (Reg B adverse action notices).
  lenderAddress                 String   @default("")
  lenderPhone                   String   @default("")
  // How long things may wait, in hours, by kind (lib/sla.ts). Unset uses the PLACEHOLDER targets there.
  slaTargets                    Json?
  // How borrowers pay: LendHous's own receiving instructions, shown on funded loans and statements. Blank says to call.
  paymentInstructions           String   @default("")
  // What a borrower earns when a friend they referred has their first loan fund (lib/referrals.ts). 0 keeps the program
  // off: no links, and nothing about it on the site.
  referralBonusCents            Int      @default(0)
  // Where a borrower who'd recommend LendHous is asked to leave a review (Google, Trustpilot): https only. Blank asks nothing.
  reviewUrl                     String   @default("")
  // Whether late fees go to partners and buyers pro rata (true) or stay with LendHous as servicer (unset or false).
  lateFeesToInvestors           Boolean?
  // Lets visitors book a call on /book. Unset counts as on.
  allowCallBooking              Boolean?
  // The last day Congress has authorized the federal flood program (NFIP) through; FEMA can't sell or renew policies after
  // it until Congress acts (lib/florida-insurance.ts). An owner updates it in Settings.
  nfipAuthorizedThrough         String   @default("2026-12-11")
  // What a draw's check costs the borrower, kept from the money released: an inspector's visit, or the team's review of the
  // borrower's photos (lib/draw-review.ts). 0 charges nothing.
  drawFeeInspectionCents        Int      @default(0)
  drawFeeDeskCents              Int      @default(0)
  updatedAt                     DateTime @updatedAt
}

// A project brief sent from the public site's /start form. Not an application: no credit is pulled and nothing is decided on it.
// Name, email, phone, city, state and notes are encrypted (lib/lead-store.ts).
model Lead {
  id                 String    @id @default(uuid()) @map("_id")
  name               String
  email              String
  phone              String    @default("")
  strategy           String
  experience         String    @default("")
  city               String
  state              String
  propertyValueCents Int
  renovationCents    Int       @default(0)
  requestedLoanCents Int
  // YYYY-MM-DD as entered; blank when the visitor has no date yet
  targetClosing      String    @default("")
  notes              String
  // From the quote request: who sent it ("borrower" or "broker"), the after-repair value, and the whole request as sealed
  // JSON (lib/quote.ts: address, broker, comps, credit band). Briefs sent before the quote form have none of these.
  submitter          String    @default("borrower")
  arvCents           Int?
  quote              String?
  contactedAt        DateTime?
  // The loan started from this brief, once staff start one.
  loanId             String?
  // The approved broker whose referral link the visitor came from (lib/brokers.ts). Their loan is attributed to it.
  brokerId           String?
  // The LendHous borrower whose referral link the visitor came from (lib/referrals.ts). Their first loan earns that
  // borrower the referral bonus.
  referrerId         String?
  // Where the request was sent from: "site" (the /start page) or "embed" / "embed:<site>" (the quote widget on a
  // partner's or one of GT's own sites, lib/quote-funnel.ts).
  channel            String    @default("site")
  // A short-lived key the visitor's browser uses to send photos of the property after the request goes in. Only its
  // hash is kept.
  photoKeyHash       String?   @unique
  photoKeyExpiresAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@index([createdAt])
}

// A call a visitor booked from the site's /book page (lib/calls.ts). One per half hour. Name, email, phone and notes are
// encrypted like a lead's.
model CallBooking {
  id        String   @id @default(uuid()) @map("_id")
  startsAt  DateTime @unique
  name      String
  email     String
  phone     String
  topic     String
  notes     String   @default("")
  createdAt DateTime @default(now())
}

model JobRun {
  id         String    @id @default(uuid()) @map("_id")
  job        String
  // job:YYYY-MM-DD, so a job runs once per day however often cron calls it
  runKey     String    @unique
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  summary    String    @default("")
}

// A published set of rates, limits and loan terms, in lib/pricing-config.ts's shape. Never changed once published: each
// loan keeps the version it was quoted on (lib/pricing-versions.ts), so a new one only changes new quotes.
model PricingVersion {
  id          String   @id @default(uuid()) @map("_id")
  version     String   @unique
  config      Json
  note        String   @default("")
  publishedBy String
  publishedAt DateTime @default(now())
}

// Treasury's OFAC sanctions list (the SDN list and its aliases), downloaded nightly by the sanctions job. One row, replaced
// whole: entries is [entry number, name, type, programs][], about 40,000 names. Loans are screened against it (lib/ofac.ts).
model SanctionsList {
  id        String   @id @map("_id")
  fetchedAt DateTime
  names     Int
  hash      String
  entries   Json
}

// The borrower application sent as a secure link (lib/borrower-application.ts). Like a photo link, only the token's hash is
// kept. The recipient, the form as filled so far and the signed copy are sealed: they hold birth dates and Social Security
// numbers, which never go into the loan book.
model ApplicationLink {
  id        String    @id @default(uuid()) @map("_id")
  tokenHash String    @unique
  // What it fills in: a loan already started, or a website lead to start one from.
  dealId    String?
  leadId    String?
  // A borrower's own application in their portal: whose it is. Its token is never shown, so only their account opens it.
  userId    String?
  recipient String
  officer   String
  sentById  String
  draft     String    @default("")
  step      Int       @default(0)
  savedAt   DateTime?
  status    String    @default("open")
  signedAt  DateTime?
  signature String?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([dealId])
  @@index([leadId])
  @@index([userId])
}

// The title company's secure link to one loan's closing (Spec T1–T3). Like a photo link, only the token's hash is kept,
// and one row per loan, so sending a new link turns the old one off. Who it went to and until when is on the loan.
model ClosingLink {
  id        String   @id @default(uuid()) @map("_id")
  dealId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// A link to a payoff letter, emailed with it (Fla. Stat. 701.04). Only the token's hash is kept. One row per letter sent,
// all opening the request's newest letter, so whoever still has an old email sees that it was corrected.
model PayoffLink {
  id        String   @id @default(uuid()) @map("_id")
  payoffId  String
  number    Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([payoffId])
}

// A server error, grouped by where it happened and what it was, so a page that fails a thousand times is one row
// (lib/errors.ts). The message has emails, long numbers and tokens taken out; no request bodies are kept.
model ErrorEvent {
  id         String    @id @default(uuid()) @map("_id")
  hash       String    @unique
  message    String
  route      String
  kind       String
  count      Int       @default(1)
  firstAt    DateTime  @default(now())
  lastAt     DateTime  @default(now())
  resolvedAt DateTime?

  @@index([lastAt])
}

// A capital partner's or loan buyer's statement for one month (lib/investor-statements.ts), kept as it was made on the
// 1st so it never changes after the fact. The figures are sealed like the loan book.
model InvestorStatement {
  id           String    @id @default(uuid()) @map("_id")
  investorType String
  investorId   String
  month        String
  data         Json
  createdAt    DateTime  @default(now())
  emailedAt    DateTime?

  @@unique([investorType, investorId, month])
  @@index([investorId])
}

// A borrower's monthly statement for one funded loan (lib/borrower-statements.ts), sealed as it was made, one per loan
// and month. borrowerId is the account it belongs to.
model BorrowerStatement {
  id         String    @id @default(uuid()) @map("_id")
  dealId     String
  borrowerId String
  month      String
  data       Json
  createdAt  DateTime  @default(now())
  emailedAt  DateTime?

  @@unique([dealId, month])
  @@index([borrowerId])
}

// A pre-approval or proof-of-funds letter (lib/letters.ts). Who it's for, its figures and its verify code are sealed;
// the public verify page finds it by a hash of the code in its QR, never by the printed number.
model ApprovalLetter {
  id           String    @id @default(uuid()) @map("_id")
  number       String    @unique
  codeHash     String    @unique
  kind         String
  borrowerId   String?
  details      String
  issuedById   String
  issuedAt     DateTime  @default(now())
  expiresOn    String
  revokedAt    DateTime?
  revokedById  String?

  @@index([borrowerId])
}

// A payee's W-9, or a foreign person's W-8BEN or W-8BEN-E (lib/tax-forms.ts), e-signed in the portal by a partner,
// buyer or broker. The form and its TIN are sealed; the newest one counts.
model TaxForm {
  id         String   @id @default(uuid()) @map("_id")
  ownerType  String
  ownerId    String
  kind       String
  data       String
  signedName String
  signedAt   DateTime @default(now())
  ip         String   @default("")
  expiresOn  String?

  @@index([ownerType, ownerId])
}

// How many visitors started a quote and saw terms, per day, channel and referral code (lib/quote-funnel.ts). No person
// or deal is stored: the terms are worked out in the browser, and only a saved quote becomes a Lead.
model QuoteCount {
  id      String @id @default(uuid()) @map("_id")
  day     String
  channel String
  ref     String @default("")
  started Int    @default(0)
  shown   Int    @default(0)

  @@unique([day, channel, ref])
}
